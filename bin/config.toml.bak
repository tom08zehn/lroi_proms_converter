[PROM.KOOS.FUPK]
column = "%(__fupk)"

[PROM.KOOS.SIDEPK]
column = "__LUT__Laterality"
[[PROM.KOOS.SIDEPK.value]]
match = "Right|R"
replace = "1"
flags = "i"
[[PROM.KOOS.SIDEPK.value]]
match = "Left|L"
replace = "2"
flags = "i"

[PROM.KOOS.KOOS26P]
column = "1. How severe is your knee stiffness after first wakening in the morning?"

[PROM.KOOS.KOOS25P]
column = "2. Twisting/pivoting on your knee"

[PROM.KOOS.KOOS19P]
column = "3. Straightening knee fully"

[PROM.KOOS.KOOS21P]
column = "4. Going up or down stairs"

[PROM.KOOS.KOOS09P]
column = "5. Standing upright"

[PROM.KOOS.KOOS38P]
column = "6. Rising from sitting"

[PROM.KOOS.KOOS34P]
column = "7. Bending to floor/pick up an object"


# =============================================================================
# PROM: EQ-5D-5L  (unified — hip / knee / shoulder)
# =============================================================================
# v1.5.0:  A single PROM section handles all three joints.
#
# The Excel export uses identical column headers regardless of joint.
# The "Procedure Type" column (e.g. "Total Knee Arthroplasty",
# "Total Hip Arthroplasty") determines which LROI XML elements to emit.
#
# Strategy: detect on "EQ-5D-5L Score" column (standard detection).
#           For each XML element that is joint-specific, use
#           $IF($CONTAINS(…),value,#(false))  so the element is emitted
#           only for the matching joint and silently skipped otherwise.
#
# XSD_ELEMENT_ORDER in converter.py lists ALL three joint variants in the
# XSD xs:choice order (shoulder → hip → knee).  Because only one joint's
# elements survive the skip filter, the output XML is XSD-compliant.

[PROM.EQ5D5L]
detection_column = "EQ-5D-5L Score"

# ── PROM-level virtual columns ──────────────────────────────────────────────
# Joint detection from "Procedure Type" (case-insensitive substring match)
__proc_lower = "$LOWER(%(Procedure Type))"
__is_hip = "$CONTAINS(%(__proc_lower),hip)"
__is_knee = "$CONTAINS(%(__proc_lower),knee)"
__is_shoulder = "$CONTAINS(%(__proc_lower),shoulder)"

# Follow-up period per joint (computed once, reused by UPNNUM + FUP elements)
# Hip / Shoulder: -1 (pre-op), 3, 12 months
__fuph = "$IF($AND($GE(%(Days to Survey Completion),-182),$LE(%(Days to Survey Completion),0)),-1,$IF($AND($GE(%(Days to Survey Completion),63),$LE(%(Days to Survey Completion),110)),3,$IF($AND($GE(%(Days to Survey Completion),323),$LE(%(Days to Survey Completion),407)),12,out of range)))"
__fups = "%(__fuph)"
# Knee: -1, 3, 6, 12 months
__fupk = "$IF($AND($GE(%(Days to Survey Completion),-182),$LE(%(Days to Survey Completion),0)),-1,$IF($AND($GE(%(Days to Survey Completion),63),$LE(%(Days to Survey Completion),110)),3,$IF($AND($GE(%(Days to Survey Completion),154),$LE(%(Days to Survey Completion),210)),6,$IF($AND($GE(%(Days to Survey Completion),323),$LE(%(Days to Survey Completion),407)),12,out of range))))"

# Is the computed follow-up period valid for this joint?
__fup_valid = "$IF(%(__is_hip),$IN(%(__fuph),-1,3,12),$IF(%(__is_knee),$IN(%(__fupk),-1,3,6,12),$IF(%(__is_shoulder),$IN(%(__fups),-1,3,12),#(false))))"

# ── Lookup table (demographics) ─────────────────────────────────────────────

[PROM.EQ5D5L.lookup]
required = true
join_column = "Admission ID"
add_columns = ["Gender", "Date of Birth"]

# ── Common elements (emitted for every joint) ───────────────────────────────

[PROM.EQ5D5L.DATUMINVUL]
column = "Date of Survey Completion"

[PROM.EQ5D5L.UPNNUM]
# Make patient ID blank if follow-up period is out of range → row skipped
column = "$IF(%(__fup_valid),%(Patient ID),)"

[PROM.EQ5D5L.GENDER]
column = "__LUT__Gender"
[[PROM.EQ5D5L.GENDER.value]]
match = "^M(ale)?$"
replace = "0"
[[PROM.EQ5D5L.GENDER.value]]
match = "^F(emale)?$"
replace = "1"

[PROM.EQ5D5L.DATBIRTH]
column = "__LUT__Date of Birth"

# ═════════════════════════════════════════════════════════════════════════════
# SHOULDER elements  (emitted only when Procedure Type contains "shoulder")
# ═════════════════════════════════════════════════════════════════════════════

[PROM.EQ5D5L.FUPS]
column = "$IF(%(__is_shoulder),%(__fups),#(false))"

[PROM.EQ5D5L.SIDES]
column = "$IF(%(__is_shoulder),%(Laterality),#(false))"
[[PROM.EQ5D5L.SIDES.value]]
match = "Right|R"
replace = "1"
[[PROM.EQ5D5L.SIDES.value]]
match = "Left|L"
replace = "2"

[PROM.EQ5D5L.EQ5D01S5L]
column = "$IF(%(__is_shoulder),%(Your mobility TODAY),#(false))"

[PROM.EQ5D5L.EQ5D02S5L]
column = "$IF(%(__is_shoulder),%(Your self-care TODAY),#(false))"

[PROM.EQ5D5L.EQ5D03S5L]
column = "$IF(%(__is_shoulder),%(Your usual activities TODAY),#(false))"

[PROM.EQ5D5L.EQ5D04S5L]
column = "$IF(%(__is_shoulder),%(Your pain / discomfort TODAY),#(false))"

[PROM.EQ5D5L.EQ5D05S5L]
column = "$IF(%(__is_shoulder),%(Your anxiety / depression TODAY),#(false))"

[PROM.EQ5D5L.EQ5D06S5L]
column = "$IF(%(__is_shoulder),%(We would like to know how good or bad your health is TODAY),#(false))"

# ═════════════════════════════════════════════════════════════════════════════
# HIP elements  (emitted only when Procedure Type contains "hip")
# ═════════════════════════════════════════════════════════════════════════════

[PROM.EQ5D5L.FUPH]
column = "$IF(%(__is_hip),%(__fuph),#(false))"

[PROM.EQ5D5L.SIDEP]
column = "$IF(%(__is_hip),%(Laterality),#(false))"
[[PROM.EQ5D5L.SIDEP.value]]
match = "Right|R"
replace = "1"
[[PROM.EQ5D5L.SIDEP.value]]
match = "Left|L"
replace = "2"

[PROM.EQ5D5L.EQ5D01P5L]
column = "$IF(%(__is_hip),%(Your mobility TODAY),#(false))"

[PROM.EQ5D5L.EQ5D02P5L]
column = "$IF(%(__is_hip),%(Your self-care TODAY),#(false))"

[PROM.EQ5D5L.EQ5D03P5L]
column = "$IF(%(__is_hip),%(Your usual activities TODAY),#(false))"

[PROM.EQ5D5L.EQ5D04P5L]
column = "$IF(%(__is_hip),%(Your pain / discomfort TODAY),#(false))"

[PROM.EQ5D5L.EQ5D05P5L]
column = "$IF(%(__is_hip),%(Your anxiety / depression TODAY),#(false))"

[PROM.EQ5D5L.EQ5D06P5L]
column = "$IF(%(__is_hip),%(We would like to know how good or bad your health is TODAY),#(false))"

# ═════════════════════════════════════════════════════════════════════════════
# KNEE elements  (emitted only when Procedure Type contains "knee")
# ═════════════════════════════════════════════════════════════════════════════

[PROM.EQ5D5L.FUPK]
column = "$IF(%(__is_knee),%(__fupk),#(false))"

[PROM.EQ5D5L.SIDEPK]
column = "$IF(%(__is_knee),%(Laterality),#(false))"
[[PROM.EQ5D5L.SIDEPK.value]]
match = "Right|R"
replace = "1"
[[PROM.EQ5D5L.SIDEPK.value]]
match = "Left|L"
replace = "2"

[PROM.EQ5D5L.EQ5D01PK5L]
column = "$IF(%(__is_knee),%(Your mobility TODAY),#(false))"

[PROM.EQ5D5L.EQ5D02PK5L]
column = "$IF(%(__is_knee),%(Your self-care TODAY),#(false))"

[PROM.EQ5D5L.EQ5D03PK5L]
column = "$IF(%(__is_knee),%(Your usual activities TODAY),#(false))"

[PROM.EQ5D5L.EQ5D04PK5L]
column = "$IF(%(__is_knee),%(Your pain / discomfort TODAY),#(false))"

[PROM.EQ5D5L.EQ5D05PK5L]
column = "$IF(%(__is_knee),%(Your anxiety / depression TODAY),#(false))"

[PROM.EQ5D5L.EQ5D06PK5L]
column = "$IF(%(__is_knee),%(We would like to know how good or bad your health is TODAY),#(false))"