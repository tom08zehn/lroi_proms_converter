__fupk = "$IF($AND($GE(%(Days to Survey Completion),-182),$LE(%(Days to Survey Completion),0)),-1,$IF($AND($GE(%(Days to Survey Completion),63),$LE(%(Days to Survey Completion),110)),3,$IF($AND($GE(%(Days to Survey Completion),154),$LE(%(Days to Survey Completion),210)),6,$IF($AND($GE(%(Days to Survey Completion),323),$LE(%(Days to Survey Completion),407)),12,out of range))))"
# Make patient ID invalid (blank) if FUPK is out of range
column = "$IF($IN(%(__fupk),-1,3,6,12),%(Patient ID),)"
